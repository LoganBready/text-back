{
  "name": "text-back",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @text-back/db generate",
    "db:migrate": "pnpm --filter @text-back/db migrate:dev",
    "db:push": "pnpm --filter @text-back/db db:push",
    "db:studio": "pnpm --filter @text-back/db studio",
    "set-role": "tsx scripts/set-role.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv": "^17.4.2",
    "prettier": "^3.5.3",
    "tsx": "^4.22.4",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
